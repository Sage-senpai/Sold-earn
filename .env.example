# sold-earn — environment template
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# Anything prefixed `NEXT_PUBLIC_` is exposed to the browser.

# ─────────────────────────────────────────────────────────────────────────
# Embedded wallet (Privy)
# ─────────────────────────────────────────────────────────────────────────
# Required to flip the `embedded` wallet provider from local mock → real
# Privy login. Without this, the embedded button still works but issues a
# deterministic local address. Get an app id at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional, depending on Privy SDK version.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# ─────────────────────────────────────────────────────────────────────────
# Solana network (used once on-chain stubs in src/lib/escrow.ts and
# src/lib/sbt.ts are replaced with real Anchor + Metaplex calls)
# ─────────────────────────────────────────────────────────────────────────
# devnet | mainnet-beta | testnet | localnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Stable USDC mint addresses:
#   devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
#   mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ─────────────────────────────────────────────────────────────────────────
# Escrow program (Anchor) — fill in after deploy
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ESCROW_PROGRAM_ID=

# ─────────────────────────────────────────────────────────────────────────
# SBT (Metaplex non-transferable NFT) — fill in after collection mint
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SBT_COLLECTION_MINT=
NEXT_PUBLIC_SBT_AUTHORITY=

# ─────────────────────────────────────────────────────────────────────────
# Protocol treasury — receives platform fee on verified sales
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TREASURY_ADDRESS=
# Fee in basis points (e.g. 1500 = 15%). Default 0 (no fee) for scaffold.
NEXT_PUBLIC_PLATFORM_FEE_BPS=0

# ─────────────────────────────────────────────────────────────────────────
# Server-side secrets (DO NOT prefix with NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────────────────────────
# Add backend keys here once we have an API route layer:
#   PRIVY_APP_SECRET=
#   ANCHOR_DEPLOYER_KEYPAIR_PATH=
