# sold-earn — environment template
# Copy to `.env.local` and fill in. `.env.local` is gitignored.
# Anything prefixed `NEXT_PUBLIC_` is exposed to the browser.

# ─────────────────────────────────────────────────────────────────────────
# Embedded wallet (Privy)
# ─────────────────────────────────────────────────────────────────────────
# Required to flip the `embedded` wallet provider from local mock → real
# Privy login. Without this, the embedded button still works but issues a
# deterministic local address. Get an app id at https://dashboard.privy.io
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional, depending on Privy SDK version.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Comma-separated login methods to surface in the modal. Default is
# "email,wallet" — those are always-on. ONLY add a provider here AFTER
# you've enabled it at dash.privy.io → Login methods, otherwise users
# will see 403 errors. Valid values: email, wallet, google, twitter,
# discord, sms.
NEXT_PUBLIC_PRIVY_LOGIN_METHODS=email,wallet

# ─────────────────────────────────────────────────────────────────────────
# Solana network (used once on-chain stubs in src/lib/escrow.ts and
# src/lib/sbt.ts are replaced with real Anchor + Metaplex calls)
# ─────────────────────────────────────────────────────────────────────────
# devnet | mainnet-beta | testnet | localnet
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Stable USDC mint addresses:
#   devnet:  4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
#   mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# ─────────────────────────────────────────────────────────────────────────
# Escrow program (Anchor) — fill in after deploy
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ESCROW_PROGRAM_ID=

# ─────────────────────────────────────────────────────────────────────────
# SBT (Metaplex non-transferable NFT) — fill in after collection mint
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SBT_COLLECTION_MINT=
NEXT_PUBLIC_SBT_AUTHORITY=

# ─────────────────────────────────────────────────────────────────────────
# Protocol treasury — receives platform fee on verified sales
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TREASURY_ADDRESS=
# Fee in basis points (e.g. 1500 = 15%). Default 1500 — 15% premium added
# on top of base × target as the required vendor deposit. Set to 0 to disable.
NEXT_PUBLIC_PLATFORM_FEE_BPS=0

# ─────────────────────────────────────────────────────────────────────────
# Supabase (server-of-truth for sales, applications, agent verifications)
# ─────────────────────────────────────────────────────────────────────────
# Without these, the app keeps working off localStorage and the agent
# layer is bypassed silently. Run `supabase/migrations/*.sql` once on
# project creation (paste into the SQL editor or `supabase db push`).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Groq (LLM provider for the Sale Verifier's buyer-note adjudication)
# ─────────────────────────────────────────────────────────────────────────
# Without GROQ_API_KEY the verifier still runs deterministic heuristics
# and just neutralizes the buyer-note signal. Get a key at
# https://console.groq.com.
GROQ_API_KEY=
# Override the default model if needed. Default is llama-3.3-70b-versatile.
GROQ_MODEL=

# ─────────────────────────────────────────────────────────────────────────
# Helius RPC (on-chain proof of payment for the Sale Verifier)
# ─────────────────────────────────────────────────────────────────────────
# When this is set, the verifier reads the buyer's USDC tx from Solana and
# confirms: tx exists, succeeded, recipient is the bounty's vendor, amount
# matches reward, and the tx is NOT signed by the scout (anti self-pay).
# Without this key the verifier falls back to a tx-format-only soft check.
# Get a key at https://www.helius.dev (free tier covers dev volume).
HELIUS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# MCP server (sold-earn exposes a Model Context Protocol endpoint at
# /api/mcp so external agents — Claude Desktop, Cursor, custom clients —
# can read marketplace state and submit sales).
# ─────────────────────────────────────────────────────────────────────────
# Reads (list_bounties, get_bounty, get_leaderboard, etc.) are always open.
# Write tools (submit_sale_proof) require this header on the request:
#   X-MCP-Key: <MCP_API_KEY>
# Leave unset to disable all writes (recommended until the marketplace
# trusts external agents). Generate a random 32-byte hex string when ready.
MCP_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Server-side secrets (DO NOT prefix with NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────────────────────────
# Add backend keys here once we have an API route layer:
#   PRIVY_APP_SECRET=
#   ANCHOR_DEPLOYER_KEYPAIR_PATH=
